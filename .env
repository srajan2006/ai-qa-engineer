# AI QA ENGINEER Configuration

# Google Gemini API Key (Leave empty to use automatic offline/demo mode fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Force Demo Mode (true/false)
DEMO_MODE=false

# Server Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Execution Timeouts
ANALYSIS_TIMEOUT=300
